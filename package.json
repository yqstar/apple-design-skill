{
  "name": "apple-design-skill",
  "version": "0.0.2",
  "description": "Apple-style interface design skills for Codex, Claude Code, Cursor and Agent Skills hosts, with versioned installation.",
  "type": "module",
  "bin": {
    "apple-design-skill": "bin/apple-design-skill.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    ".codex-plugin/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:example": "node scripts/check-example.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run check",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yqstar/apple-design-skill.git"
  },
  "homepage": "https://github.com/yqstar/apple-design-skill#readme",
  "bugs": {
    "url": "https://github.com/yqstar/apple-design-skill/issues"
  },
  "author": "yqstar",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "apple-design",
    "codex",
    "claude-code",
    "cursor",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
