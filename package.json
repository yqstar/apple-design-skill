    "release:check": "node scripts/release-check.mjs"
  },
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/yqstar/apple-design-skill.git" },
  "homepage": "https://github.com/yqstar/apple-design-skill#readme",
  "bugs": { "url": "https://github.com/yqstar/apple-design-skill/issues" },
  "author": "yqstar",
  "license": "MIT",
  "keywords": ["agent-skills", "apple-design", "codex", "claude-code", "cursor", "multi-agent", "accessibility"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
